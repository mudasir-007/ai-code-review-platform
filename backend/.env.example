# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_code_review"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5050

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# ─── GitHub OAuth (create an OAuth App at https://github.com/settings/developers) ──
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5050/api/auth/github/callback

# ─── GitHub API token (optional — increases rate limit & enables private repos) ─
# Generate at https://github.com/settings/tokens  (scopes: repo, read:org)
# NOTE: the `repo` scope is required if you want autoPr — the token needs
# write access to create branches, commits and pull requests.
GITHUB_TOKEN=

# ─── Auto-PR thresholds (used by scoringService when autoPr: true) ────────────
# Auto-PR fires when the AI health score drops below this value...
PR_SCORE_THRESHOLD=60
# ...or when the weighted issue score (errors x3 + warnings x1) reaches this.
PR_ISSUE_THRESHOLD=8

# ─── AI Providers (at least one is required) ──────────────────────────────────
# Groq  — free tier available at https://console.groq.com
GROQ_API_KEY=

# Gemini — free tier available at https://aistudio.google.com
GEMINI_API_KEY=
